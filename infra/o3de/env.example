# VectorFlow ↔ O3DE environment
#
# Copy to .env (or export) before launching a local O3DE client or SSR worker.
# O3DE never talks to VictoriaMetrics / PromQL — that is the Telemetry Resolver.

VF_BRIDGE_VERSION=vf.bridge.v1

# Scene Graph Service bridge endpoint (transport evolves with the Gem)
VF_SGS_BRIDGE_URL=unix:///tmp/vf-sgs-bridge.sock

# client = local GPU fat client (default for desktop)
# worker = SSR encode path for browser streaming (Linux/Windows GPU hosts)
VF_SESSION_MODE=client

# Do NOT set:
# VICTORIAMETRICS_URL=
# PROMETHEUS_URL=
# VF_PROMQL_=

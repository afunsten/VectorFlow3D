# VectorFlow3D <-> Pixel Streaming environment
#
# Copy to .env (or export) before launching the Pixel Streaming stack.
#
# Domain boundary: the signalling server, SFU, and reference streamer NEVER talk
# to VictoriaMetrics / PromQL. Telemetry lives behind the Telemetry Resolver only
# (same rule as O3DE — see infra/o3de/env.example).

# --- Container images -------------------------------------------------------
# Wilbur = the signalling web server, formerly named "Cirrus". Use current
# naming going forward.
#
# NOTE: the upstream repo moved from github.com/EpicGames to
# github.com/EpicGamesExt in 2024, and the official ghcr.io/epicgames images are
# NOT publicly pullable (they return "unauthorized"). The defaults below use the
# community "pixelstreamingunofficial/*" Docker Hub images (5.5-5.8 published),
# which pull without auth. They are amd64-only, so they run under emulation on
# Apple Silicon (works; slower).
#
# If you have Epic registry access, you can instead use the official images:
#   PS_SIGNALLING_IMAGE=ghcr.io/epicgames/pixel-streaming-signalling-server:5.5
#   PS_SFU_IMAGE=ghcr.io/epicgames/pixel-streaming-sfu:5.5
#
# Keep the signalling + SFU + reference streamer on the same UE line so the
# WebRTC signalling protocol versions match.
PS_SIGNALLING_IMAGE=pixelstreamingunofficial/pixel-streaming-signalling-server:5.8
PS_SFU_IMAGE=pixelstreamingunofficial/pixel-streaming-sfu:5.8

# --- Wilbur ports -----------------------------------------------------------
PS_HTTP_PORT=80 # player / frontend web server (open this in a browser)
PS_STREAMER_PORT=8888 # streamers (O3DE / reference streamer) connect here
PS_SFU_PORT=8889 # SFU connects here

# --- SFU (Linux only) -------------------------------------------------------
# host networking bypasses compose DNS, so this points at 127.0.0.1, not the
# "signalling" service name. See docker-compose.yml sfu notes + README.
PS_SFU_SIGNALLING_URL=ws://127.0.0.1:8889

# --- Reference streamer (synthetic test pattern) ----------------------------
# Connects to Wilbur's streamer port and pushes a synthetic video feed so you
# can validate the signalling / transport / protocol path end to end.
PS_SIGNALLING_STREAMER_URL=ws://signalling:8888
PS_STREAM_WIDTH=1280
PS_STREAM_HEIGHT=720
PS_STREAM_FPS=30
PS_STREAM_CODEC=h264 # h264 | vp8
PS_STREAM_PATTERN=colorbars # colorbars | smpte | gradient
PS_STREAMER_ID=vf-reference-streamer

# --- Do NOT set (domain boundary) -------------------------------------------
# VICTORIAMETRICS_URL=
# PROMETHEUS_URL=
# VF_PROMQL_=
